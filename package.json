{
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/check-node.js && next dev",
    "build": "node scripts/check-node.js && next build",
    "start": "node scripts/check-node.js && next start",
    "lint": "next lint --max-warnings 0",
    "test": "jest --runInBand",
    "test:e2e": "node e2e/smoke.js",
    "test:e2e:browser": "playwright test",
    "verify": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "convert-svg": "svgr --no-dimensions --out-dir ./components/images ./assets/images"
  },
  "dependencies": {
    "@emailjs/browser": "^3.12.1",
    "@headlessui/react": "^1.4.3",
    "@sendgrid/mail": "^8.1.0",
    "@svgr/webpack": "^6.2.0",
    "emailjs-com": "^3.2.0",
    "formik": "^2.4.5",
    "graphql": "^16.2.0",
    "graphql-request": "^3.7.0",
    "html-react-parser": "^1.4.5",
    "moment": "^2.29.1",
    "next": "12.0.8",
    "next-absolute-url": "^1.2.2",
    "nodemailer": "^6.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-drag-drop-files": "^2.3.10",
    "react-icons": "^4.3.1",
    "react-input-mask": "^2.0.4",
    "react-multi-carousel": "^2.6.5",
    "react-player": "^2.9.0",
    "sass": "^1.49.0",
    "swiper": "^7.4.1",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@svgr/cli": "^6.2.0",
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@testing-library/dom": "^8.20.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@unform/core": "^2.1.6",
    "@unform/web": "^2.1.6",
    "autoprefixer": "^10.4.2",
    "eslint": "^8.31.0",
    "eslint-config-next": "^12.0.8",
    "jest": "^27.5.1",
    "jest-environment-jsdom": "^27.5.1",
    "postcss": "^8.4.5",
    "tailwind-scrollbar": "^1.3.1",
    "tailwindcss": "^3.0.16"
  }
}
